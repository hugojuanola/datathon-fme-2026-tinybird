# Handed out at the RawTree stand when the team registered. Copy to .env and fill in the key.
# Never commit .env (it is git-ignored). Ask Hugo or Javier for the key.
TEAM_ID=team_06
RAWTREE_API_KEY=rt_...

# Optional. Where bulky, fast-changing files go (history export, caches, logs). Default: data/ and logs/
# in the repo. If the repo lives in a synced folder (OneDrive, Dropbox…), point these OUTSIDE it: the
# sync client uploading them starves the live loop (it cost us 25 % of the answers for 8 minutes).
# SKORE_DATA_DIR=C:/Users/you/skore_money/data
# SKORE_LOGS_DIR=C:/Users/you/skore_money/logs
